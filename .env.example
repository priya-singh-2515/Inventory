# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/invoice-db

# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-char-random-string
BETTER_AUTH_URL=http://localhost:3000

# Set to "true" only when MongoDB is a replica set or mongos (Atlas always is).
# A standalone mongod rejects transactions, which breaks sign-up.
MONGODB_TRANSACTIONS=false
